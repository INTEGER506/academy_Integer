<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ac.kr.academy.mapper.user.UserMapper">
    <insert id="insertUser" parameterType="com.ac.kr.academy.domain.user.User">
        <selectKey keyProperty="id" order="BEFORE" resultType="long">
            SELECT user_seq.NEXTVAL FROM dual
        </selectKey>
        INSERT INTO users (id, username, password_temp, email, password, phone, name, role)
        VALUES (#{id}, #{username}, #{passwordTemp}, #{email, jdbcType=VARCHAR}, #{password}, #{phone, jdbcType=VARCHAR}, #{name}, #{role})
    </insert>

    <!-- 변경하고 싶은것만 변경하기 위해 <if> 추가 작성 -->
    <update id="updateUser" parameterType="com.ac.kr.academy.domain.user.User">
        UPDATE users
        <set>
        <if test="email != null">
            email = #{email, jdbcType=VARCHAR},
        </if>
        <if test="phone != null">
            phone = #{phone, jdbcType=VARCHAR},
        </if>
        <if test="name != null">
            name = #{name},
        </if>
        <if test="role != null">
            role = #{role},
        </if>
        <if test="password != null">
            password = #{password, jdbcType=VARCHAR}
        </if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteUser">
        DELETE FROM users WHERE id = #{id}
    </delete>

    <!-- 전체 사용자 ID 조회 - 알림 -->
    <select id="findAllUserIds" resultType="long">
        SELECT id FROM users
    </select>

    <select id="findAllUsers" resultType="com.ac.kr.academy.domain.user.User">
        SELECT * FROM users
    </select>

    <select id="findById" resultType="com.ac.kr.academy.domain.user.User" parameterType="long">
        SELECT * FROM users
        WHERE id = #{id}
    </select>

    <select id="findAllUsersByRole" resultType="com.ac.kr.academy.domain.user.User">
        SELECT id FROM users
        WHERE role = #{role}
    </select>

    <select id="findByUsername" resultType="com.ac.kr.academy.domain.user.User" parameterType="string">
        SELECT *
        FROM users
        WHERE username = #{username}
    </select>

    <update id="updateUserPassword">
        UPDATE users
        SET password = #{password},
            password_temp = #{passwordTemp}
        WHERE username = #{username}
    </update>
    
    <update id="updateUsername">
        UPDATE users
        SET username = #{username}
        WHERE id = #{id}
    </update>

</mapper>