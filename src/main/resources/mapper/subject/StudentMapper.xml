<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ac.kr.academy.mapper.student.StudentMapper">

    <!-- student 테이블의 컬럼을 Student 도메인 객체의 필드에 매핑 -->
    <resultMap id="studentResultMap" type="com.ac.kr.academy.domain.student.Student">
        <id property="id" column="id"/>
        <result property="studentNum" column="student_num"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="endedAt" column="ended_at"/>
        <result property="deptId" column="dept_id"/>
        <result property="userId" column="user_id"/>
    </resultMap>

    <!-- 학생 ID로 학생 정보를 조회하는 SQL -->
    <select id="findById" resultMap="studentResultMap">
        SELECT
            id,
            student_num,
            status,
            created_at,
            ended_at,
            dept_id,
            user_id
        FROM
            student
        WHERE
            id = #{id}
    </select>

    <!-- 학번으로 학생 정보를 조회하는 SQL -->
    <select id="findByStudentNum" resultMap="studentResultMap">
        SELECT
            id,
            student_num,
            status,
            created_at,
            ended_at,
            dept_id,
            user_id
        FROM
            student
        WHERE
            student_num = #{studentNum}
    </select>

    <!-- 사용자 ID로 학생 정보를 조회하는 SQL -->
    <select id="findByUserId" resultMap="studentResultMap">
        SELECT
            id,
            student_num,
            status,
            created_at,
            ended_at,
            dept_id,
            user_id
        FROM
            student
        WHERE
            user_id = #{userId}
    </select>
</mapper>
