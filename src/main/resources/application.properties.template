spring.application.name=academy

# --- Server ---
server.port=8082

# --- View Resolver ---
spring.mvc.view.prefix=/WEB-INF/views/
spring.mvc.view.suffix=.jsp

# --- Encoding ---
server.servlet.encoding.charset=UTF-8
server.servlet.encoding.force=true

## Log monitoring - log file path // = logging.file.name=./logs/app.log
logging.file.name=./logs/app.log
#logging.file.path=./logs
#logging.file.name=app.log

# --- Logging ---
logging.level.org.springframework.security=DEBUG
logging.level.com.ac.kr.academy.security=DEBUG
logging.level.jdbc.sqlonly=DEBUG
logging.level.org.mybatis=DEBUG
logging.level.com.zaxxer.hikari=INFO

# --- Oracle Database ---
spring.datasource.driver-class-name=oracle.jdbc.OracleDriver
spring.datasource.url=jdbc:oracle:thin:@localhost:1521/XEPDB1
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD

# --- MyBatis ---
mybatis.mapper-locations=classpath*:mapper/**/*.xml
mybatis.type-aliases-package=com.ac.kr.academy.domain.user
mybatis.configuration.map-underscore-to-camel-case=true
mybatis.configuration.default-statement-timeout=30

# --- JWT ---
app.jwt.secret=YOUR_JWT_SECRET
app.jwt.access-token-validity-seconds=3600
app.jwt.refresh-token-validity-seconds=1209600

# --- HikariCP ---
spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.minimum-idle=2
spring.datasource.hikari.pool-name=HikariPool-1